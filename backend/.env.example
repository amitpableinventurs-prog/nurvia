NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5280,http://localhost:5281
# Swagger UI at /api-docs (spec at /api-docs.json). Defaults to on outside production.
API_DOCS=
# Set to the number of proxy hops (e.g. 1) when running behind a load balancer.
TRUST_PROXY=

# MongoDB Atlas or self-hosted replica set
MONGODB_URI=mongodb://127.0.0.1:27017/nurvia

DEFAULT_TENANT=nurvia
UTC_OFFSET_MINUTES=330

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
OTP_HASH_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30

# console = log codes to the terminal and return them in dev responses. Never use in production.
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# Phone channels the OTP provider can deliver on (sms, whatsapp, voice)
OTP_PHONE_CHANNELS=sms,whatsapp,voice
# Domain for iOS one-time-code autofill (defaults to WEB_BASE_URL's host)
OTP_APP_DOMAIN=
# Development only: make every code this value, e.g. 123456 (console provider, not production)
OTP_FIXED_CODE=

# Sign in with Google / Apple: comma-separated OAuth client IDs (web, Android, iOS). Empty = off.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Legal: bump TERMS_VERSION when the Terms or Privacy Policy change
TERMS_VERSION=2026-01
TERMS_URL=
PRIVACY_URL=
SUPPORT_URL=

UPLOAD_DIR=storage
UPLOAD_MAX_BYTES=10485760

# mock | razorpay
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# console | fcm (fcm needs `npm i firebase-admin` and GOOGLE_APPLICATION_CREDENTIALS)
PUSH_PROVIDER=console

# direct: customers get the shop's own number. A masking provider (Exotel, Knowlarity) is not wired yet.
CALL_RELAY_PROVIDER=direct

# disabled until Nurvia approves an AI provider
AI_PROVIDER=disabled

JOBS_ENABLED=true

# Used by `npm run seed` to create the first super admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
